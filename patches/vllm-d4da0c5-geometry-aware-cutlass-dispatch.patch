From: MiniMax M3 MSA B300 crossover study
Subject: [PATCH] minimax_m3: make CUTLASS decode crossover geometry-aware

The common batch-16 threshold is a stable win for TP1-like 64/4, but not for
TP4-like 16/1. Ten independent-process B300 CUDA Graph runs place the first
tested stable TP4 win at batch 64. Do not extrapolate to unmeasured geometry.

This patch targets vLLM commit d4da0c5 and is intentionally not applied to the
repository's pinned vendor snapshot.

diff --git a/vllm/models/minimax_m3/nvidia/msa_cutlass_sparse_decode.py b/vllm/models/minimax_m3/nvidia/msa_cutlass_sparse_decode.py
--- a/vllm/models/minimax_m3/nvidia/msa_cutlass_sparse_decode.py
+++ b/vllm/models/minimax_m3/nvidia/msa_cutlass_sparse_decode.py
@@ -25,2 +25,4 @@
-# Kernel benchmarks put the CUTLASS crossover at 16 requests for TP1 and TP4.
-_MIN_CUTLASS_BATCH_SIZE = 16
+# Conservative B300 CUDA Graph thresholds for one-token decode. Preserve the
+# existing threshold for speculative decode shapes not measured in this study.
+_MIN_CUTLASS_BATCH_SIZE = {(64, 4): 16, (16, 1): 64}
+_DEFAULT_MIN_CUTLASS_BATCH_SIZE = 16
@@ -238,16 +240,22 @@ def should_prepare_decode_metadata(
 ) -> bool:
     """Return whether a graph shape can use the CUTLASS decode path."""
     total_q = batch_size * decode_query_len
+    min_batch_size = (
+        _MIN_CUTLASS_BATCH_SIZE.get((num_q_heads, num_kv_heads))
+        if decode_query_len == 1
+        else _DEFAULT_MIN_CUTLASS_BATCH_SIZE
+    )
     return (
         supports_cutlass_sparse_decode(
             decode_backend=decode_backend,
             num_q_heads=num_q_heads,
             num_kv_heads=num_kv_heads,
             kv_cache_dtype=kv_cache_dtype,
             page_size=page_size,
             topk_blocks=topk_blocks,
         )
         and 1 <= decode_query_len <= _MAX_DECODE_QUERY_LEN
-        and batch_size >= _MIN_CUTLASS_BATCH_SIZE
+        and min_batch_size is not None
+        and batch_size >= min_batch_size
         and total_q * num_q_heads <= _MAX_QUERY_HEAD_ROWS
     )
